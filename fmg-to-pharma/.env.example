# Configure secrets in Vercel, scoped to this preview branch. Never commit actual values.
# Default is closed. Production is explicitly rejected by this sandbox implementation.
FMG_PILOT_MODE=closed
FMG_PILOT_ORIGIN=https://REPLACE_WITH_EXACT_PREVIEW_HOST.vercel.app
FMG_PILOT_ADMIN_TOKEN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FMG_AI_ENABLED=false
AI_GATEWAY_API_KEY=
FMG_RESEARCH_MODEL=openai/gpt-5.4-mini
FMG_SYNTHESIS_MODEL=openai/gpt-5.4-fast
FMG_NOTIFICATION_MODE=capture
# Leave disabled until specific test recipients and sending are authorized.
FMG_EMAIL_TEST_APPROVED=false
FMG_EMAIL_TEST_RECIPIENTS=
# Optional approved QA mailbox for customer-template tests; must also be in the allowlist.
FMG_EMAIL_TEST_CUSTOMER=
FMG_EMAIL_FROM=
FMG_FOUNDER_EMAIL=
FMG_SMTP_HOST=
FMG_SMTP_PORT=465
FMG_SMTP_USER=
FMG_SMTP_PASSWORD=

# Preview-only opt-in; never enables customer checkout or production generation.
FMG_AI_PROFILE=
FMG_GATEWAY_AUDIT_MODE=off
